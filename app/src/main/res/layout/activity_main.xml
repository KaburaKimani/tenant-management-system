<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="android.view.View" />
        <variable
            name="tenant"
            type="com.example.tenantmanagementsystem.Tenant" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#1C1B1F"
        android:padding="20dp">

        <TextView
            android:id="@+id/titleTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="TENANT MANAGEMENT SYSTEM"
            android:textColor="#E6DDF5"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="20dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <EditText
            android:id="@+id/tenantNameEditText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Enter tenant name"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"
            android:inputType="textPersonName"
            android:minHeight="48dp"
            app:layout_constraintTop_toBottomOf="@id/titleTextView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <EditText
            android:id="@+id/phoneEditText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Enter phone number"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"
            android:inputType="phone"
            android:minHeight="48dp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tenantNameEditText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <EditText
            android:id="@+id/rentEditText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Enter rent paid"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"
            android:inputType="numberDecimal"
            android:minHeight="48dp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/phoneEditText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/saveButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="SAVE"
            android:textColor="#2F2450"
            android:backgroundTint="#D2BFFF"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/rentEditText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tenantSummaryTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@{tenant != null ? tenant.summary() : ``}"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:padding="0dp"
            android:visibility="@{tenant != null ? View.VISIBLE : View.GONE}"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/saveButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/callButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="CALL TENANT"
            android:textColor="#2F2450"
            android:backgroundTint="#D2BFFF"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/tenantSummaryTextView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
